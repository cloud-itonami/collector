{
  "name": "kotodama-c0ll3ct1",
  // "main" dropped 2026-08-26 (Svelte -> ClojureScript migration): it used to
  // point at the SvelteKit build (`svelte/.svelte-kit/cloudflare/_worker.js`),
  // which no longer exists now that `svelte/` is deleted. `src/app.ts` is a
  // real Worker (health/meta + XRPC-to-dispatcher proxy) but it does NOT call
  // `env.ASSETS.fetch()`, so it must not be repointed here as `main` — doing
  // so would put a worker in front of the static assets with nothing serving
  // them. UNVERIFIED: no `wrangler deploy`/`dev` was run to confirm this.
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"bpmn-dispatch\"]",
    "APP_DEPLOY_AT": "2026-04-12T00:43:11Z",
    "APP_DEPLOY_SHA": "0f598c04445",
    "APP_DESCRIPTION": "Thin edge facade; collector business logic runs in BPMN + Zeebe Python",
    "APP_DISPLAY_NAME": "etzhayyim Collector",
    "APP_EMBED_URL": "https://c0ll3ct1.etzhayyim.com/?embed=1",
    "APP_FRAMEWORK": "cljs-reagent-re-frame-jp-go-dds",
    "APP_NANOID": "c0ll3ct1",
    "APP_PERFORMER_TYPE": "service",
    "APP_SOURCE": "custom",
    "APP_TEMPLATE": "",
    "APP_UI_TYPE": "appview",
    "APP_VERSION": "0.1.0",
    "INTERFACES_REQUIRES": "[\"etzhayyim:collection/collection@1.0.0\"]",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "routes": [
    {
      "pattern": "collector.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./cljs/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
